# ---------- Rust ----------
debug/
target/

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
**/mutants.out*/

# ---------- .NET ----------
**/bin/
**/obj/
*.user
*.suo
.vs/

# Native binaries staged into the .NET project by release CI for `dotnet pack`.
dotnet/runtimes/

# ---------- Unity package native binaries ----------
# Binaries are committed only on release tags by CI (uses `git add -f`).
# Their `.meta` files are tracked statically alongside source.
unity/Runtime/Plugins/**/*.dll
unity/Runtime/Plugins/**/*.so
unity/Runtime/Plugins/**/*.dylib

# ---------- IDE / OS junk ----------
.idea/
.vscode/
.DS_Store
Thumbs.db
/.claude/settings.local.json
