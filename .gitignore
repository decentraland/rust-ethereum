# ---------- Rust ----------
debug/
target/

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
**/mutants.out*/

# ---------- .NET ----------
**/bin/
**/obj/
*.user
*.suo
.vs/

# Native binaries staged into the .NET project by release CI for `dotnet pack`.
dotnet/runtimes/

# ---------- Unity package (generated by release CI) ----------
# C# sources are mirrored from `dotnet/` and native binaries are produced by the
# matrix builds; both are committed only on release tags via `git add -f`.
# The corresponding `.meta` files (with stable GUIDs) are tracked on main.
unity/Runtime/RustEth*.cs
unity/Runtime/Plugins/**/*.dll
unity/Runtime/Plugins/**/*.so
unity/Runtime/Plugins/**/*.dylib

# ---------- IDE / OS junk ----------
.idea/
.vscode/
.DS_Store
Thumbs.db
/.claude/settings.local.json
